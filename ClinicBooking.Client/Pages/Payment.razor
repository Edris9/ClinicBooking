@page "/payments"
@inject HttpClient Http
@using ClinicBooking.Client.Models
@using System.Net.Http.Json

<PageTitle>Payments</PageTitle>

<h1>Payments</h1>

@* NYTT: meddelande *@
@if (message != null)
{
    <div class="alert @(success ? "alert-success" : "alert-danger")">@message</div>
}

@if (payments == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Patient</th>
                <th>Belopp</th>
                <th>Anledning</th>
                <th>Skapad</th>
                <th>Förfaller</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in payments)
            {
                <tr>
                    <td>@PatientName(payment.AppointmentId)</td>
                    <td>@payment.Amount.ToString("N2") kr</td>
                    <td>@payment.Reason</td>
                    <td>@payment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>@payment.DueDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>@payment.Status</td>
                    <td>
                        @* NYTT: betallänk-knapp *@
                        @if (payment.Status != "Paid")
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => SendLink(payment.Id)">Skicka betallänk</button>
                        }
                        <button class="btn btn-danger btn-sm ms-2" @onclick="() => DeletePayment(payment.Id)">Delete</button>
						<button class="btn btn-primary btn-sm ms-2" @onclick="() => EditPayment(payment.Id)">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<EditForm Model="@newPayment" OnValidSubmit="@CreatePayment">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="appointmentId" class="form-label">Bokning</label>
        <InputSelect id="appointmentId" class="form-select" @bind-Value="newPayment.AppointmentId">
            <option value="0" disabled>Välj bokning</option>
            @if (appointments != null)
            {
                @foreach (var a in appointments.Where(a => a.Status != "Cancelled"))
                {
                    <option value="@a.Id">@a.ScheduledAt.ToString("yyyy-MM-dd HH:mm") – @PatientName(a.Id)</option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label for="amount" class="form-label">Belopp (kr)</label>
        <InputNumber id="amount" class="form-control" @bind-Value="newPayment.Amount" />
    </div>

    <div class="mb-3">
        <label for="reason" class="form-label">Anledning</label>
        <InputText id="reason" class="form-control" @bind-Value="newPayment.Reason" />
    </div>

    <button type="submit" class="btn btn-primary">Skapa faktura</button>
</EditForm>

@code {
    private List<PaymentDto>? payments;
    private List<AppointmentDto>? appointments;
    private List<PatientDto>? patients;

    private CreatePaymentDto newPayment = new();

    // NYTT
    private string? message;
    private bool success;

    protected override async Task OnInitializedAsync()
    {
        patients = await Http.GetFromJsonAsync<List<PatientDto>>("api/patients");
        appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("api/appointments");
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        payments = await Http.GetFromJsonAsync<List<PaymentDto>>("api/payments");
    }

    private async Task CreatePayment()
    {
        await Http.PostAsJsonAsync("api/payments", newPayment);
        newPayment = new();
        await LoadPayments();
    }

    private async Task DeletePayment(int id)
    {
        await Http.DeleteAsync($"api/payments/{id}");
        await LoadPayments();
    }

	
    private async Task EditPayment(int id)
    {
        var payment = payments?.FirstOrDefault(p => p.Id == id);
        if (payment != null)
        {
            newPayment = new CreatePaymentDto
            {
                AppointmentId = payment.AppointmentId,
                Amount = payment.Amount,
                Reason = payment.Reason
            };
            await Http.PutAsJsonAsync($"api/payments/{id}", newPayment);
            newPayment = new();
            await LoadPayments();
        }
	}

    // NYTT
    private async Task SendLink(int id)
    {
        var response = await Http.PostAsync($"api/payments/{id}/send-link", null);
        success = response.IsSuccessStatusCode;
        message = success ? "Länk skickad till patientens e-post!" : "Kunde inte skicka länken.";
        await LoadPayments();
    }

    private string PatientName(int appointmentId)
    {
        var appointment = appointments?.FirstOrDefault(a => a.Id == appointmentId);
        return patients?.FirstOrDefault(p => p.Id == appointment?.PatientId)?.Name ?? "Okänd";
    }
}