@page "/doctors"
@inject HttpClient Http
@using ClinicBooking.Client.Models
@using System.Net.Http.Json



<h3>Doctors</h3>

@if(doctors == null)
{
	<p><em>Loading...</em></p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>Name</th>
				<th>Specialty</th>
				<th>PhoneNumber</th>
				<th>Email</th>
				<th>DepartmentId</th>
				<th>Actions</th>
				<th>Uppdate</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var doctor in doctors)
			{
				<tr>
					<td>@doctor.Name</td>
					<td>@doctor.Specialty</td>
					<td>@doctor.PhoneNumber</td>
					<td>@doctor.Email</td>
					<td>@doctor.DepartmentId</td>
					<td><button class="btn btn-danger" @onclick="() => DeleteDoctor(doctor.Id)">Delete</button></td>
					<td><button class="btn btn-primary" @onclick="() => StartEdit(doctor)">Edit</button></td>

				</tr>
			}
		</tbody>
	</table>
	<EditForm Model="@newDoctor" OnValidSubmit="@CreateDoctor">
		<DataAnnotationsValidator />
		<ValidationSummary />
		<div class="mb-3">
			<label for="name" class="form-label">Name</label>
			<InputText id="name" class="form-control" @bind-Value="newDoctor.Name" />
		</div>
		<div class="mb-3">
			<label for="specialty" class="form-label">Specialty</label>
			<InputText id="specialty" class="form-control" @bind-Value="newDoctor.Specialty" />
		</div>
		<div class="mb-3">
			<label for="phoneNumber" class="form-label">Phone Number</label>
			<InputText id="phoneNumber" class="form-control" @bind-Value="newDoctor.PhoneNumber" />
		</div>
		<div class="mb-3">
			<label for="email" class="form-label">Email</label>
			<InputText id="email" class="form-control" @bind-Value="newDoctor.Email" />
		</div>
		<div class="mb-3">
			<label for="departmentId" class="form-label">Department ID</label>
			<InputNumber id="departmentId" class="form-control" @bind-Value="newDoctor.DepartmentId" />
		</div>
	<button type="submit" class="btn btn-primary">@(editingId.HasValue ? "Spara ändringar" : "Add Doctor")</button>
	</EditForm>
@code {
	private List<DoctorDto>? doctors;
	protected override async Task OnInitializedAsync()
	{

		doctors = await Http.GetFromJsonAsync<List<DoctorDto>>("api/doctors");
	}

	private CreateDoctorDto newDoctor = new();
	private async Task CreateDoctor()
	{
		if (editingId.HasValue)
		{
			var doctorToUpdate = new DoctorDto
			{
				Id = editingId.Value,
				Name = newDoctor.Name,
				Specialty = newDoctor.Specialty,
				PhoneNumber = newDoctor.PhoneNumber,
				Email = newDoctor.Email,
				DepartmentId = newDoctor.DepartmentId
			};
			await UpdateDoctor(doctorToUpdate);
			editingId = null;
		}
		else
		{
			await Http.PostAsJsonAsync("api/doctors", newDoctor);
		}
		newDoctor = new CreateDoctorDto();
		doctors = await Http.GetFromJsonAsync<List<DoctorDto>>("api/doctors");
	}
	private async Task DeleteDoctor(int id)
	{
		await Http.DeleteAsync($"api/doctors/{id}");
		doctors = await Http.GetFromJsonAsync<List<DoctorDto>>("api/doctors");
	}

	private async Task UpdateDoctor(DoctorDto doctor)
	{
		await Http.PutAsJsonAsync($"api/doctors/{doctor.Id}", doctor);
		doctors = await Http.GetFromJsonAsync<List<DoctorDto>>("api/doctors");
	}

	private int? editingId;

	private void StartEdit(DoctorDto doctor)
	{
		editingId = doctor.Id;
		newDoctor = new CreateDoctorDto
		{
			Name = doctor.Name,
			Specialty = doctor.Specialty,
			PhoneNumber = doctor.PhoneNumber,
			Email = doctor.Email,
			DepartmentId = doctor.DepartmentId
		};
	}

}
}